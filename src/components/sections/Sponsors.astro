---
import Section from "./Section.astro";
const industries = [
  { name: "Gyms & Fitness" },
  { name: "Restaurants" },
  { name: "Cafes" },
  { name: "Dental Clinics" },
  { name: "Salons & Spas" },
  { name: "Coaching" },
  { name: "Real Estate" },
  { name: "Corporate" }
];
---

<Section id="sponsors">
  <div class="flex flex-col items-center gap-10">
    <h3 class="text-2xl md:text-3xl font-medium text-center">Businesses We Build For</h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 w-full">
      {
        industries.map((industry) => {
          return (
            <div class="px-6 py-8 border border-zinc-200 rounded-2xl bg-zinc-50 flex items-center justify-center transition-all duration-300 hover:shadow-md hover:-translate-y-1 hover:border-zinc-300">
              <span class="font-medium text-lg text-center text-zinc-800">{industry.name}</span>
            </div>
          );
        })
      }
    </div>
  </div>
</Section>