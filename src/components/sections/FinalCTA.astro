---
import Section from "./Section.astro";
---

<Section id="contact">
  <div class="mt-[140px] mb-[140px]">
    <div class="bg-dark rounded-[45px] overflow-hidden relative py-20 px-10 md:px-20 text-center">
      <!-- Decorative background -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-accent via-dark to-dark"></div>
      
      <div class="relative z-10 max-w-3xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-bold text-white mb-6">Let's Build Something Amazing Together.</h2>
        <p class="text-zinc-400 text-lg mb-10">Stop losing customers to outdated websites. Partner with Guildry to build a premium online experience that grows your business.</p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="mailto:hello@guildry.com" class="px-8 py-4 bg-accent text-white font-medium rounded-2xl hover:scale-105 transition-transform w-full sm:w-auto text-lg">
            Book Free Consultation
          </a>
          <a href="https://wa.me/123456789" target="_blank" class="px-8 py-4 bg-transparent border border-zinc-600 text-white font-medium rounded-2xl hover:bg-white hover:text-black transition-all w-full sm:w-auto text-lg">
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>
