---
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";

const features = [
  "48 Hour Delivery",
  "Fully Responsive",
  "Lightning Fast",
  "SEO Ready",
  "Premium UI",
  "Clean Code",
  "Future Scalable",
  "WhatsApp Integration",
  "Animations",
  "CMS Ready",
  "Hosting Support",
];
---

<Section id="why-choose-us">
  <div class="mt-[140px]">
    <SectionTitle
      sectionTitle="Why Choose Us"
      description="We don't just build websites; we craft digital experiences that drive growth and elevate your brand."
    />
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-10">
      {
        features.map((feature) => (
          <div class="flex items-center gap-3 p-6 bg-zinc-50 border border-zinc-200 rounded-2xl hover:border-accent hover:shadow-sm transition-all group">
            <div class="w-2 h-2 rounded-full bg-accent group-hover:scale-125 transition-transform"></div>
            <span class="font-medium text-zinc-800">{feature}</span>
          </div>
        ))
      }
    </div>
  </div>
</Section>
