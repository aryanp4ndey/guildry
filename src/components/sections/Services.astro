---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";
import c4 from "../../assets/pics/card-pic4.png";
import c5 from "../../assets/pics/card-pic5.png";
import c6 from "../../assets/pics/card-pic6.png";

const cards = [
  {
    index: 1,
    titleTop: "Premium Business",
    titleBottom: "Websites",
    img: c1,
    alt: "Premium Websites",
    link: "/#contact",
  },
  {
    index: 2,
    titleTop: "Landing",
    titleBottom: "Pages",
    img: c2,
    alt: "Landing Pages",
    link: "/#contact",
  },
  {
    index: 3,
    titleTop: "Website",
    titleBottom: "Redesign",
    img: c3,
    alt: "Website Redesign",
    link: "/#contact",
  },
  {
    index: 1,
    titleTop: "Booking",
    titleBottom: "Websites",
    img: c4,
    alt: "Booking Websites",
    link: "/#contact",
  },
  {
    index: 2,
    titleTop: "E-Commerce",
    titleBottom: "Websites",
    img: c5,
    alt: "E-Commerce",
    link: "/#contact",
  },
  {
    index: 3,
    titleTop: "Website",
    titleBottom: "Maintenance",
    img: c6,
    alt: "Maintenance",
    link: "/#contact",
  },
];

const description =
  "At Guildry, we offer a range of premium web design and development services tailored to help your business establish a powerful online presence.";
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-3 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
