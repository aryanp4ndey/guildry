---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero.svg";
---

<Section id="home">
<div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
            <h1 class="text-5xl font-medium leading-[1.2] md:text-7xl text-center md:text-left tracking-tight">Websites That Turn <br> Visitors Into <br> Customers.</h1>
            <p class="mt-6 mb-8 text-lg font-normal leading-7 sm:mb-12 text-center md:text-left md:pr-12 text-zinc-600">We design and build premium business websites for local businesses, startups and growing brands.</p>
            <div class="w-full justify-center md:justify-start items-center inline-flex gap-4">
                <a href="#contact" class="px-8 py-4 bg-accent hover:bg-black rounded-2xl text-center text-white transition-all text-xl font-normal leading-7">Get Free Consultation</a>
                <a href="#portfolio" class="px-8 py-4 bg-transparent hover:bg-zinc-100 rounded-2xl text-center text-black border border-zinc-900 transition-all text-xl font-normal leading-7">View Portfolio</a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10 relative">
        <div class="w-full h-[400px] md:h-[500px] bg-zinc-100 rounded-[30px] border border-zinc-200 shadow-xl overflow-hidden flex flex-col items-center justify-center relative">
            <div class="absolute top-0 w-full h-10 bg-zinc-200/50 border-b border-zinc-200 flex items-center px-4 gap-2">
               <div class="w-3 h-3 rounded-full bg-red-400"></div>
               <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
               <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <p class="text-zinc-400 font-medium mt-10">Website Mockup Placeholder</p>
            
            <!-- Floating Cards -->
            <div class="absolute top-20 -left-6 bg-white px-4 py-3 rounded-xl shadow-lg border border-zinc-100 animate-bounce" style="animation-duration: 3s;">
                <span class="font-medium">⚡ Responsive</span>
            </div>
            <div class="absolute bottom-20 -right-6 bg-white px-4 py-3 rounded-xl shadow-lg border border-zinc-100 animate-bounce" style="animation-duration: 4s;">
                <span class="font-medium">⚡ Fast</span>
            </div>
            <div class="absolute top-40 right-4 bg-white px-4 py-3 rounded-xl shadow-lg border border-zinc-100 animate-bounce" style="animation-duration: 3.5s;">
                <span class="font-medium">⚡ SEO Ready</span>
            </div>
        </div>
    </div>
</div>
</Section>