---
import Accordion from "../ui/Accordion.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";

const description = "A transparent, step-by-step guide to how we build your premium website from start to finish.";
---

<Section id="process">
  <div class="mt-[140px]">
    <SectionTitle
      sectionTitle="Our Working Process"
      description={description}
    />
    <Accordion />
  </div>
</Section>