---
import MainLayout from "../layouts/MainLayout.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";

const generalFaqs = [
  {
    index: 1,
    title: "How long does a typical website build take?",
    description: "Our standard business website sprint takes 2 to 4 weeks from discovery to official launch. E-commerce platforms and complex web portals typically take 4 to 6 weeks."
  },
  {
    index: 2,
    title: "Will my website look good on mobile phones?",
    description: "Every website we build is mobile-first. Over 70% of web traffic comes from mobile devices, so we ensure sub-second rendering, crisp touch targets, and flawless layout adaptation on modern smartphones."
  },
  {
    index: 3,
    title: "Can I update content on the site myself later?",
    description: "Yes! We integrate an easy-to-use Content Management System (CMS) that allows you to change text, upload images, add new blog posts, or edit prices without needing any coding skills."
  }
];

const techFaqs = [
  {
    index: 4,
    title: "Why build with Astro & React instead of WordPress?",
    description: "Traditional WordPress sites rely on heavy plugins and bloated php scripts that cause slow page speeds (3-7 seconds) and security vulnerabilities. Our modern stack (Astro/React/Tailwind) delivers sub-second load speeds (<0.5s), 95+ Core Web Vitals, and bulletproof security."
  },
  {
    index: 5,
    title: "How does Guildry help with local Google SEO?",
    description: "We write clean, semantic HTML5 code, integrate Schema.org structured data, optimize Google Search Console indexing, generate automated sitemaps, and optimize site speed so search engines rank your business higher."
  },
  {
    index: 6,
    title: "Can you integrate WhatsApp and booking forms?",
    description: "Yes! We can add direct one-click WhatsApp chat triggers, appointment calendars, contact forms, or custom lead capture forms linked directly to your email or CRM."
  }
];

const billingFaqs = [
  {
    index: 7,
    title: "What are your payment terms?",
    description: "We work on a standard 50/50 milestone structure: 50% upfront upon signing the agreement to initiate the sprint, and 50% upon final launch approval after full quality testing."
  },
  {
    index: 8,
    title: "Are there any hidden recurring fees?",
    description: "Zero hidden fees. You own your website 100%. Hosting costs are paid directly to top-tier CDN providers (e.g. Vercel/Cloudflare) which are often free or under $10/mo depending on traffic."
  },
  {
    index: 9,
    title: "What happens if I need help after the website launches?",
    description: "Every package comes with included VIP post-launch support (ranging from 1 to 12 months). We also offer monthly care & maintenance retainers if you want us to handle all technical management ongoing."
  }
];
---

<MainLayout 
  title="FAQ & Help Center | Guildry — Web Development Questions" 
  description="Got questions about Guildry's web development process, pricing, timeline, or technologies? Browse our detailed FAQ."
>
  <main class="overflow-hidden">
    <!-- Hero Banner -->
    <section class="pt-28 pb-16 px-6 md:px-12 max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 text-accent font-medium text-sm mb-6 border border-accent/20">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Got Questions?
      </div>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-zinc-900 mb-6">
        Everything You Need <br /><span class="bg-gradient-to-r from-accent via-blue-500 to-indigo-600 bg-clip-text text-transparent">To Know About Guildry.</span>
      </h1>
      <p class="text-lg md:text-xl text-zinc-600 max-w-3xl mx-auto leading-relaxed">
        Transparent answers regarding our engineering process, pricing structures, technology stack, and ongoing support.
      </p>
    </section>

    <!-- FAQ Accordion Sections -->
    <section class="py-12 px-6 md:px-12 max-w-5xl mx-auto space-y-16">
      <!-- Group 1 -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-accent"></div>
          <h2 class="text-2xl font-bold text-zinc-900">General & Process</h2>
        </div>
        <div class="space-y-4">
          {generalFaqs.map((faq) => (
            <AccordionItem index={faq.index} title={faq.title} description={faq.description} />
          ))}
        </div>
      </div>

      <!-- Group 2 -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-accent"></div>
          <h2 class="text-2xl font-bold text-zinc-900">Engineering & Performance</h2>
        </div>
        <div class="space-y-4">
          {techFaqs.map((faq) => (
            <AccordionItem index={faq.index} title={faq.title} description={faq.description} />
          ))}
        </div>
      </div>

      <!-- Group 3 -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-accent"></div>
          <h2 class="text-2xl font-bold text-zinc-900">Billing & Ownership</h2>
        </div>
        <div class="space-y-4">
          {billingFaqs.map((faq) => (
            <AccordionItem index={faq.index} title={faq.title} description={faq.description} />
          ))}
        </div>
      </div>
    </section>

    <!-- Direct Support Box -->
    <section class="py-12 px-6 md:px-12 max-w-5xl mx-auto">
      <div class="p-8 md:p-12 bg-zinc-900 text-white rounded-3xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h3 class="text-2xl font-bold">Have a specific question not listed here?</h3>
          <p class="text-zinc-400 text-sm">Speak directly with a lead developer on WhatsApp — zero sales pressure.</p>
        </div>
        <a 
          href="https://wa.me/123456789" 
          target="_blank" 
          class="px-6 py-4 bg-accent text-white font-bold rounded-2xl hover:bg-white hover:text-black transition-all shrink-0"
        >
          Chat on WhatsApp
        </a>
      </div>
    </section>

    <FinalCTA />
  </main>
</MainLayout>
